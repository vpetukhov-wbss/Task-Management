# ============================================
# Task Management System - Environment Variables
# ============================================
# Copy this file to .env and update the values

# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Set to 'Development' for local dev or 'Production' for production
ASPNETCORE_ENVIRONMENT=Development

# ============================================
# DATABASE CONFIGURATION
# ============================================
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# Options: Developer (free), Express (free), Standard, Enterprise
MSSQL_PID=Developer
DB_NAME=TaskManagementSystem

# Resource Limits (adjust based on environment)
# Development: 2 CPUs, 4GB RAM | Production: 4 CPUs, 8GB RAM
DB_CPU_LIMIT=2
DB_CPU_RESERVATION=1
DB_MEMORY_LIMIT=4g
DB_MEMORY_RESERVATION=1g

# ============================================
# API CONFIGURATION
# ============================================
API_PORT=5000

# JWT Configuration - CHANGE THESE IN PRODUCTION!
JWT_SECRET_KEY=your_secret_key_here_change_it_please_make_it_longer_than_32_characters
JWT_ISSUER=TaskManagementSystem
JWT_AUDIENCE=TaskManagementSystem

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Resource Limits
API_CPU_LIMIT=2
API_CPU_RESERVATION=1
API_MEMORY_LIMIT=2g
API_MEMORY_RESERVATION=512m

# API Replicas (1 for dev, 2+ for production)
API_REPLICAS=1

# ============================================
# UI CONFIGURATION
# ============================================
UI_PORT=3000
REACT_APP_API_URL=http://localhost:5000/api

# Resource Limits
UI_CPU_LIMIT=1
UI_CPU_RESERVATION=0.5
UI_MEMORY_LIMIT=512m
UI_MEMORY_RESERVATION=128m

# ============================================
# SEQ - STRUCTURED LOGGING
# ============================================
SEQ_PORT=8081
SEQ_INGESTION_PORT=5341
SEQ_API_KEY=abcde12345
# Leave empty for dev, set password hash for production
SEQ_ADMIN_PASSWORD_HASH=

# ============================================
# JAEGER - DISTRIBUTED TRACING
# ============================================
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Storage (memory for dev, badger for production)
JAEGER_SPAN_STORAGE_TYPE=memory

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log file settings
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ============================================
# TIMEZONE
# ============================================
TZ=UTC

# ============================================
# PRODUCTION SETTINGS EXAMPLE
# ============================================
# For production, change these values:
# ASPNETCORE_ENVIRONMENT=Production
# MSSQL_PID=Standard
# DB_CPU_LIMIT=4
# DB_CPU_RESERVATION=2
# DB_MEMORY_LIMIT=8g
# DB_MEMORY_RESERVATION=2g
# API_REPLICAS=2
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# REACT_APP_API_URL=https://api.yourdomain.com/api
# JWT_SECRET_KEY=<generate-strong-random-key-minimum-32-characters>
# JAEGER_SPAN_STORAGE_TYPE=badger
# LOG_MAX_FILES=5
